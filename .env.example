# --- Jev access: set ONE key ----------------------------------------------------
# Via OpenRouter (https://openrouter.ai/keys). The endpoint is set automatically:
#   https://openrouter.ai/api/v1/systemone
OPENROUTER_API_KEY=
# ...or directly from TypeSafe (https://console.typesafe.ai/). Wins if both are set.
TYPESAFE_API_KEY=

# Optional overrides - leave commented out unless you use another gateway.
# TYPESAFE_API_BASE=https://openrouter.ai/api
# TYPESAFE_MODEL=jev-latest        # or pin a version, e.g. jev-1.13
# JEV_MODE=auto                    # auto | live (fail without a key) | mock

# --- Catalog source ----------------------------------------------------------------
# seed : bundled curated catalog in FragDB schema (works out of the box)
# csv  : licensed FragDB CSV export  (set FRAGDB_CSV_DIR)
# api  : FragDB Data API - NOT USABLE YET (the index has no record data; see README)
CATALOG_SOURCE=seed
FRAGDB_CSV_DIR=./data/fragdb
FRAGDB_API_KEY=

# --- Server ------------------------------------------------------------------------
PORT=8787
